DATABASE_URL=postgresql+psycopg://nfe:nfe-password@db:5432/nfe
POSTGRES_PASSWORD=replace-with-a-random-password
ROOT=/vol1/your-storage/nfe
WEB_PORT=8080
OBJECTS_DIR=/var/lib/nfe/objects
STAGING_DIR=/var/lib/nfe/staging
EXPORTS_DIR=/var/lib/nfe/exports
BACKUPS_DIR=/var/lib/nfe/backups
SESSION_COOKIE=nfe_session
APP_TIMEZONE=America/Sao_Paulo
MAX_XML_BYTES=10485760
MAX_ZIP_BYTES=524288000
MAX_ZIP_MEMBERS=50000
